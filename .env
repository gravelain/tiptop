# =====================
# SonarQube
# =====================
SONAR_JDBC_URL=jdbc:postgresql://postgres_sonarqube:5432/mydatabase_prod
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar

# =====================
# Backend
# =====================
NODE_ENV=production
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/mydatabase_dev.sqlite"

# =====================
# Grafana et outils divers
# =====================
GRAFANA_ADMIN_PASSWORD_prod=mygrafanapassword
GRAFANA_ADMIN_PASSWORD=admin@tiptop.com

# =====================
# Jenkins
# =====================
JENKINS_ADMIN_ID=jenkins_admin
JENKINS_ADMIN_PASSWORD=jenkins_admin
