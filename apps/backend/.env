# Variables pour SonarQube
SONAR_JDBC_URL=jdbc:postgresql://postgres:5432/my_postgres_db
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar
SONAR_FORCEAUTHENTICATION=true

# Variables spécifiques à Grafana et autres outils
GRAFANA_ADMIN_PASSWORD_prod=mygrafanapassword
GRAFANA_ADMIN_PASSWORD=admin@tiptop.com

# Variables pour jenkins
JENKINS_ADMIN_ID=jenkins_admin
JENKINS_ADMIN_PASSWORD=jenkins_admin

# MYSQL et POSTGRESQL DEV
MYSQL_ROOT_PASSWORD_dev=ml_root_pwd_dev
MYSQL_DATABASE_dev=ml_db_dev
MYSQL_USER_dev=ml_user_dev
MYSQL_PASSWORD_dev=ml_pwd_dev

POSTGRES_USER_dev=pg_user_dev
POSTGRES_PASSWORD_dev=pg_pwd_dev
POSTGRES_DB_dev=pg_db_dev

# MYSQL et POSTGRESQL PREPROD
MYSQL_ROOT_PASSWORD_preprod=ml_root_pwd_preprod
MYSQL_DATABASE_preprod=ml_db_preprod
MYSQL_USER_preprod=ml_user_preprod
MYSQL_PASSWORD_preprod=ml_pwd_preprod

POSTGRES_USER_preprod=pg_user_preprod
POSTGRES_PASSWORD_preprod=pg_pwd_preprod
POSTGRES_DB_preprod=pg_db_preprod

# MYSQL et POSTGRESQL PROD
MYSQL_ROOT_PASSWORD_prod=ml_root_pwd_prod
MYSQL_DATABASE_prod=ml_db_prod
MYSQL_USER_prod=ml_user_prod
MYSQL_PASSWORD_prod=ml_pwd_prod

POSTGRES_USER_prod=pg_user_prod
POSTGRES_PASSWORD_prod=pg_pwd_prod
POSTGRES_DB_prod=pg_db_prod

#Ma connexion 
DATABASE_URL=mysql://${MYSQL_USER_dev}:${MYSQL_PASSWORD_dev}@mysql:3306/${MYSQL_DATABASE_dev}

