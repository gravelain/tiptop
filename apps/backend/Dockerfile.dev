# Utilisation de PHP 8.2 avec FPM
FROM php:8.2-fpm

# Définir le dossier de travail
WORKDIR /var/www/html

# Installer les dépendances nécessaires
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev libicu-dev \
    libonig-dev libxml2-dev curl libcurl4-openssl-dev \
    sqlite3 libsqlite3-dev \
    && docker-php-ext-install zip intl opcache mbstring xml dom curl pdo pdo_sqlite \
    && docker-php-ext-enable pdo_sqlite

# Installer Composer globalement
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Copier le code source de l'application backend dans le conteneur
COPY apps/backend/ /var/www/html/

# Définir les permissions correctes
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

# Installer les dépendances PHP du projet (si composer.json existe)
RUN if [ -f "composer.json" ]; then composer install --prefer-dist --no-progress --no-interaction; fi

# Exposer le port utilisé par PHP-FPM
EXPOSE 9000

# Lancer PHP-FPM au démarrage du conteneur
CMD ["php-fpm"]
