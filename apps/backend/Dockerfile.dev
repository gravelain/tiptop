# Utilisation de l'image php:8.2-fpm
FROM php:8.2-fpm

WORKDIR /var/www/html

# Installation des paquets nécessaires pour PostgreSQL et d'autres dépendances
RUN apt-get update && apt-get install -y \
    git unzip libpq-dev libzip-dev libicu-dev \
    libonig-dev libxml2-dev curl libcurl4-openssl-dev \
    && docker-php-ext-install pdo_pgsql zip intl opcache mbstring xml dom curl

# Installer Composer globalement
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Installer wait-for-it (outil pour attendre que PostgreSQL soit prêt)
RUN apt-get install -y wait-for-it

# Copier le script wait-for-postgres.sh dans le conteneur
COPY apps/backend/wait-for-postgres.sh /usr/local/bin/wait-for-postgres.sh

# Donner les permissions d'exécution au script
RUN chmod +x /usr/local/bin/wait-for-postgres.sh

# Copier le code source de l'application backend dans le conteneur
COPY apps/backend/ /var/www/html/

# Copier et préparer le script docker-entrypoint.sh
COPY apps/backend/docker-entrypoint.sh /usr/src/app/docker-entrypoint.sh
RUN chmod +x /usr/src/app/docker-entrypoint.sh

# Exposer le port 5000 (que tu utiliseras probablement pour PHP-FPM)
EXPOSE 5000

# Commande d'entrée : exécuter wait-for-postgres et ensuite composer et php-fpm
CMD /usr/local/bin/wait-for-postgres.sh postgres 5432 bdd_user bdd_pass -- /bin/sh -c "composer install --prefer-dist --no-progress --no-interaction && php bin/console cache:clear --no-warmup && php-fpm"
