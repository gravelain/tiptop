# Utiliser une image PHP avec FPM et les extensions nécessaires
FROM php:8.2-fpm

# Définir le répertoire de travail
WORKDIR /var/www/html

# Installer les dépendances système et extensions PHP requises par Symfony
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libpq-dev \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libxml2-dev \
    curl \
    libcurl4-openssl-dev \
    && docker-php-ext-install \
    pdo_mysql \
    zip \
    intl \
    opcache \
    mbstring \
    xml \
    curl

# Installer Composer
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# Copier composer.json depuis apps/backend vers le conteneur
COPY apps/backend/composer.json /var/www/html/composer.json
COPY apps/backend/composer.lock /var/www/html/composer.lock

# Copier tout le reste du projet (y compris le fichier .env) vers le conteneur
COPY . /var/www/html/

# Copier le fichier .env dans le conteneur
COPY .env /var/www/html/.env

# Installer les dépendances
RUN composer install --prefer-dist --no-progress --no-interaction

# S'assurer que l'autoloader est bien généré
RUN composer dump-autoload

# Vérifier si bin/console est bien généré
RUN ls -al /var/www/html/bin/console
# Exposer le port pour PHP-FPM
EXPOSE 5000

# Commande pour démarrer PHP-FPM
CMD ["php-fpm"]
