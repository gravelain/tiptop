# Utilisation de l'image php:8.2-fpm
FROM php:8.2-fpm

WORKDIR /var/www/html

# Installer les dépendances nécessaires pour SQLite et d'autres extensions PHP
RUN apt-get update && apt-get install -y \
    git unzip libzip-dev libicu-dev \
    libonig-dev libxml2-dev curl libcurl4-openssl-dev \
    && docker-php-ext-install zip intl opcache mbstring xml dom curl pdo_sqlite

# Installer Composer globalement
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Copier le code source de l'application backend dans le conteneur
COPY apps/backend/ /var/www/html/

# Exposer le port 5000 (que tu utiliseras probablement pour PHP-FPM)
EXPOSE 5000

# Commande d'entrée : exécuter composer install et php-fpm
CMD /bin/sh -c "composer install --prefer-dist --no-progress --no-interaction && php bin/console cache:clear --no-warmup && php-fpm"
