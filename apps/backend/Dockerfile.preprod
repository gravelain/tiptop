# 🐘 Utiliser une image PHP avec FPM pour Symfony
FROM php:8.2-fpm AS preprod

# Définir le répertoire de travail
WORKDIR /var/www/html

# Installer les dépendances système et les extensions PHP requises par Symfony
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libpq-dev \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libxml2-dev \
    curl \
    libcurl4-openssl-dev \
    && docker-php-ext-install \
    pdo_mysql \
    zip \
    intl \
    opcache

# Installer Composer
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# Copier le projet
COPY . .

# Installer les dépendances sans les dev dependencies (pour préprod)
RUN composer install --no-dev --optimize-autoloader --no-progress --no-interaction

# Exposer le port pour PHP-FPM
EXPOSE 5000

# Commande pour démarrer PHP-FPM
CMD ["php-fpm"]
